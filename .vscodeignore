# Node / TypeScript build inputs
node_modules/**
src/**
out/test/**
tsconfig.json
.eslintrc.json
.vscode/**
.vscode-test/**
dist/**

# Git / CI
.git/**
.github/**
.gitignore
.gitattributes

# Python build + test artefacts (the runtime package itself is shipped)
tests/**
test_data/**
scripts/**
**/__pycache__/**
**/*.pyc
**/*.pyo
.pytest_cache/**
*.egg-info/**
build/**
.venv/**
venv/**

# Docs that are not part of the packaged extension
AGENTS.md
demo/**/*.ipynb

# Capture scratch: raw walkthrough frames and tooling never ship.
# The finished media/activity-bar.svg and the walkthrough GIF DO ship, because
# the Activity Bar icon and the README's "See it in action" section need them.
media/frames/**
media/**/*.psd
**/frames/**
capture*.py
assemble*.py

# Never ship anything credential-shaped
**/.env
**/*.pem
**/*.key
**/*.pfx
**/secrets*
