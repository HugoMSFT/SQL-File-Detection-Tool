{
  "name": "sql-file-detection-tool",
  "displayName": "SQL File Detection Tool",
  "description": "Preview CSV, JSON, Parquet, Delta, and Iceberg data, map schemas to SQL types, and generate T-SQL for SQL Server, Azure SQL, and Fabric.",
  "version": "1.0.2",
  "publisher": "HugoMSFT",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sql",
    "azure sql",
    "parquet",
    "delta lake",
    "azure storage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoMSFT/SQL-File-Detection-Tool.git"
  },
  "bugs": {
    "url": "https://github.com/HugoMSFT/SQL-File-Detection-Tool/issues"
  },
  "homepage": "https://github.com/HugoMSFT/SQL-File-Detection-Tool#readme",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:sqlFileDetectionTool.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlFileDetectionTool",
          "title": "SQL File Detection Tool",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "sqlFileDetectionTool": [
        {
          "type": "webview",
          "id": "sqlFileDetectionTool.sidebar",
          "name": "SQL File Detection Tool",
          "icon": "media/activity-bar.svg",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "sqlFileDetectionTool.open",
        "title": "Open",
        "category": "SQL File Detection Tool"
      },
      {
        "command": "sqlFileDetectionTool.analyzeCurrentFile",
        "title": "Analyze Current File",
        "category": "SQL File Detection Tool"
      },
      {
        "command": "sqlFileDetectionTool.analyzeSelected",
        "title": "Analyze with SQL File Detection Tool"
      },
      {
        "command": "sqlFileDetectionTool.openInEditor",
        "title": "Open in Editor",
        "category": "SQL File Detection Tool"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sqlFileDetectionTool.analyzeSelected",
          "when": "resourceExtname =~ /^\\.(csv|tsv|txt|dat|json|jsonl|ndjson|parquet|snappy|orc|rc)$/i || explorerResourceIsFolder",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "sqlFileDetectionTool.analyzeCurrentFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(csv|tsv|txt|dat|json|jsonl|ndjson|parquet|snappy|orc|rc)$/i",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "sqlFileDetectionTool.analyzeCurrentFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(csv|tsv|txt|dat|json|jsonl|ndjson|parquet|snappy|orc|rc)$/i",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "sqlFileDetectionTool.analyzeSelected",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SQL File Detection Tool",
      "properties": {
        "sqlFileDetectionTool.defaultPlatform": {
          "type": "string",
          "default": "azure_sql_db",
          "enum": [
            "azure_sql_db",
            "azure_sql_mi",
            "sql_server_2025",
            "sql_server_2022",
            "sql_server_2019",
            "fabric_sql_db"
          ],
          "enumDescriptions": [
            "Azure SQL Database (default)",
            "Azure SQL Managed Instance",
            "SQL Server 2025",
            "SQL Server 2022",
            "SQL Server 2019",
            "Fabric SQL Database"
          ],
          "markdownDescription": "Target SQL platform used when generating T-SQL. Defaults to **Azure SQL Database**."
        },
        "sqlFileDetectionTool.defaultView": {
          "type": "string",
          "default": "editor",
          "enum": [
            "editor",
            "sidebar"
          ],
          "enumDescriptions": [
            "Open the full interface in an editor tab (default)",
            "Keep the full interface in the Activity Bar sidebar"
          ],
          "markdownDescription": "Where **Open**, analysis commands, and the Activity Bar entry display the interface."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "sqlFileDetectionTool.getStarted",
        "title": "Get started with SQL File Detection Tool",
        "description": "Analyze data files and generate Azure SQL Database T-SQL. Nothing to install: the extension runs natively in VS Code.",
        "steps": [
          {
            "id": "openTool",
            "title": "Open the tool",
            "description": "Select the SQL File Detection Tool icon in the Activity Bar. The full interface opens immediately in an editor tab — there is no setup step, no interpreter check and no server to wait for.\n[Open the tool](command:sqlFileDetectionTool.open)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:sqlFileDetectionTool.open"
            ]
          },
          {
            "id": "analyzeFile",
            "title": "Analyze a data file",
            "description": "Open any CSV, TSV, DAT, JSON, NDJSON, Parquet, ORC, Delta or Iceberg source and analyze it, or right-click one in the Explorer.\n[Analyze the current file](command:sqlFileDetectionTool.analyzeCurrentFile)",
            "media": {
              "markdown": "media/walkthrough/analyze.md"
            },
            "completionEvents": [
              "onCommand:sqlFileDetectionTool.analyzeCurrentFile"
            ]
          },
          {
            "id": "reviewSql",
            "title": "Review the generated T-SQL",
            "description": "Preview is the first tab. CREATE TABLE, BULK INSERT, OPENROWSET and external-table scripts are generated for the selected platform. Credential setup guides compatible storage and authentication choices without collecting secrets.",
            "media": {
              "markdown": "media/walkthrough/sql.md"
            }
          },
          {
            "id": "configureStorage",
            "title": "Set up external storage",
            "description": "Paste an ABS, ADLS, or ABFSS storage URL. The extension infers the connector and generates the platform-aware credential and external data source.",
            "media": {
              "markdown": "media/walkthrough/azure.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "node scripts/build.js",
    "bundle:dev": "node scripts/build.js --dev",
    "compile": "node scripts/clean-output.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src scripts --ext .ts,.js",
    "icon": "node scripts/generate-icon.js",
    "notices": "node scripts/generate-notices.js",
    "test": "npm run compile && npm run bundle && node scripts/run-tests.js",
    "version:check": "node scripts/check-extension-version.js",
    "package": "node scripts/ensure-dist.js && vsce package --readme-path MARKETPLACE.md --changelog-path MARKETPLACE_CHANGELOG.md --out dist",
    "audit:vsix": "node scripts/audit-vsix.js",
    "capture:gif": "npm run compile && node scripts/capture-walkthrough.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "fflate": "^0.8.3",
    "hyparquet": "^1.29.2",
    "iconv-lite": "^0.7.3"
  }
}
